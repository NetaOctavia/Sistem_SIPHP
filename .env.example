# =====================================================
# TEMPLATE KONFIGURASI — SALIN FILE INI MENJADI .env
# Isi nilainya sesuai environment masing-masing
# =====================================================

# Django Secret Key — generate dengan perintah:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=ganti-dengan-secret-key-anda

# Mode Debug — True untuk development, False untuk production
DEBUG=True

# Host yang diizinkan — pisahkan dengan koma
ALLOWED_HOSTS=127.0.0.1,localhost
